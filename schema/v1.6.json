{
  "$defs": {
    "BoundingBox": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Confidence": {
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/ConfidenceType"
        }
      },
      "required": [
        "value",
        "type"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceType": {
      "enum": [
        "exact",
        "detected",
        "inferred"
      ],
      "title": "ConfidenceType",
      "type": "string"
    },
    "CoordinateSystem": {
      "description": "The units every coordinate on the page is expressed in (\u00a74, \u00a716).",
      "properties": {
        "origin": {
          "default": "top_left",
          "title": "Origin",
          "type": "string"
        },
        "units": {
          "default": "reference_pixels",
          "title": "Units",
          "type": "string"
        },
        "reference_resolution": {
          "default": 150,
          "title": "Reference Resolution",
          "type": "integer"
        }
      },
      "title": "CoordinateSystem",
      "type": "object"
    },
    "Direction": {
      "description": "Writing direction of a text element (\u00a713).",
      "enum": [
        "ltr",
        "rtl",
        "ttb",
        "unknown"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Element": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "reading_order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading Order"
        },
        "typography": {
          "anyOf": [
            {
              "$ref": "#/$defs/Typography"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Direction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextLayout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "grid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "geometry",
        "confidence",
        "provenance"
      ],
      "title": "Element",
      "type": "object"
    },
    "Geometry": {
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "rotation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "GridPosition": {
      "description": "Where a cell sits in its table. Zero-indexed from the top-left.",
      "properties": {
        "row": {
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "title": "Column",
          "type": "integer"
        },
        "row_span": {
          "default": 1,
          "title": "Row Span",
          "type": "integer"
        },
        "column_span": {
          "default": 1,
          "title": "Column Span",
          "type": "integer"
        },
        "is_header": {
          "default": false,
          "title": "Is Header",
          "type": "boolean"
        }
      },
      "required": [
        "row",
        "column"
      ],
      "title": "GridPosition",
      "type": "object"
    },
    "Page": {
      "properties": {
        "page_number": {
          "title": "Page Number",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PageStatus"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "coordinate_system": {
          "$ref": "#/$defs/CoordinateSystem"
        },
        "source_type": {
          "default": "born_digital",
          "title": "Source Type",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/PageIssue"
          },
          "title": "Errors",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/PageIssue"
          },
          "title": "Warnings",
          "type": "array"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Elements",
          "type": "array"
        },
        "diagnostic_elements": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Diagnostic Elements",
          "type": "array"
        }
      },
      "required": [
        "page_number",
        "status",
        "width",
        "height"
      ],
      "title": "Page",
      "type": "object"
    },
    "PageIssue": {
      "description": "A structured, page-scoped problem \u2014 used for both errors and warnings.\n\nErrors mean the page could not produce a valid v1 result. Warnings mean it\ndid, but something about it is suspect (\u00a718). Both carry a stable ``code``\nso consumers branch on that rather than on message text.",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "stage",
        "message"
      ],
      "title": "PageIssue",
      "type": "object"
    },
    "PageStatus": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ],
      "title": "PageStatus",
      "type": "string"
    },
    "Point": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Provenance": {
      "description": "Where an element's content came from, and whether a human changed it.\n\n`source` is the ORIGINAL producer and never changes on edit:\n`modified_by_user` marks a machine value a human corrected, while\n`source=manual` is reserved for elements a human created from nothing.",
      "properties": {
        "source": {
          "$ref": "#/$defs/ProvenanceSource"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "raw_confidence": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Confidence"
        },
        "modified_by_user": {
          "default": false,
          "title": "Modified By User",
          "type": "boolean"
        },
        "original_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Text"
        }
      },
      "required": [
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceSource": {
      "enum": [
        "native_pdf",
        "layout_model",
        "table_model",
        "geometry_inference",
        "manual",
        "ocr",
        "visual_inference"
      ],
      "title": "ProvenanceSource",
      "type": "string"
    },
    "TextLayout": {
      "description": "Where a line sits inside its paragraph (\u00a77), measured from geometry.\n\nSeparate from Typography, which reports what the file said rather than\nwhat was computed. All values are 150 DPI reference pixels.",
      "properties": {
        "indent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indent"
        },
        "line_height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Height"
        },
        "alignment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alignment"
        }
      },
      "title": "TextLayout",
      "type": "object"
    },
    "Typography": {
      "description": "Type information carried verbatim from the PDF text layer.\n\n`font_size` is in points, not the 150 DPI pixels used for geometry.\n`flags` is the PyMuPDF span bitfield; `color` is packed sRGB.",
      "properties": {
        "font_family": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Family"
        },
        "font_size": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Font Size"
        },
        "flags": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Flags"
        },
        "color": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        }
      },
      "title": "Typography",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.6",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "filename": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Filename"
    },
    "page_count": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Count"
    },
    "pages": {
      "items": {
        "$ref": "#/$defs/Page"
      },
      "title": "Pages",
      "type": "array"
    }
  },
  "required": [
    "document_id"
  ],
  "title": "Document",
  "type": "object"
}
