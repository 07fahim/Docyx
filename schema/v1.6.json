{
  "$defs": {
    "BoundingBox": {
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        },
        "width": {
          "title": "Width",
          "type": "number"
        },
        "height": {
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "Confidence": {
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "type": {
          "$ref": "#/$defs/ConfidenceType"
        }
      },
      "required": [
        "value",
        "type"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceType": {
      "enum": [
        "exact",
        "detected",
        "inferred"
      ],
      "title": "ConfidenceType",
      "type": "string"
    },
    "CoordinateSystem": {
      "description": "What every coordinate on this page means (\u00a74, \u00a716).\n\nEmitted rather than assumed. The invariant \u2014 top-left origin, reference\npixels at 150 DPI \u2014 is enforced at every boundary in code and stated in\nCLAUDE.md, but it was never in the output, so a consumer reading the JSON\nhad to already know it or guess from the numbers. For a format whose whole\nclaim is that it describes itself, leaving the unit implicit was the one\nplace it did not.\n\nConstant in v1. It is a field rather than a documented convention so that\nrendering at another DPI, or a backend with a bottom-left origin, is a\nvalue change instead of a silent reinterpretation of every box ever\nexported.",
      "properties": {
        "origin": {
          "default": "top_left",
          "title": "Origin",
          "type": "string"
        },
        "units": {
          "default": "reference_pixels",
          "title": "Units",
          "type": "string"
        },
        "reference_resolution": {
          "default": 150,
          "title": "Reference Resolution",
          "type": "integer"
        }
      },
      "title": "CoordinateSystem",
      "type": "object"
    },
    "Direction": {
      "description": "Writing direction of a text element (\u00a713).\n\nTracked per element, not per page: a page may mix directions, and forcing\none global direction on it loses that. Read from the line's direction vector\n(vertical vs horizontal) and the Unicode bidi category of the characters\nthemselves (LTR vs RTL), so it is derived, never guessed.\n\nNot from the span's ``bidi`` embedding level, which real Arabic PDFs report\nas 0 on every span \u2014 see ``_direction`` in docyx/pdf/text_extractor.py.\n\nPer-element *language* is deliberately absent: PDFs carry no such field, so\npopulating it would mean detection, which could not honestly be `exact`.",
      "enum": [
        "ltr",
        "rtl",
        "ttb",
        "unknown"
      ],
      "title": "Direction",
      "type": "string"
    },
    "Element": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/Geometry"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "reading_order": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading Order"
        },
        "typography": {
          "anyOf": [
            {
              "$ref": "#/$defs/Typography"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/Direction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "layout": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextLayout"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "script": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script"
        },
        "grid": {
          "anyOf": [
            {
              "$ref": "#/$defs/GridPosition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "children": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "geometry",
        "confidence",
        "provenance"
      ],
      "title": "Element",
      "type": "object"
    },
    "Geometry": {
      "properties": {
        "bbox": {
          "$ref": "#/$defs/BoundingBox"
        },
        "polygon": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Point"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polygon"
        },
        "rotation": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rotation"
        }
      },
      "required": [
        "bbox"
      ],
      "title": "Geometry",
      "type": "object"
    },
    "GridPosition": {
      "description": "Where a cell sits in its table. Zero-indexed from the top-left.",
      "properties": {
        "row": {
          "title": "Row",
          "type": "integer"
        },
        "column": {
          "title": "Column",
          "type": "integer"
        },
        "row_span": {
          "default": 1,
          "title": "Row Span",
          "type": "integer"
        },
        "column_span": {
          "default": 1,
          "title": "Column Span",
          "type": "integer"
        },
        "is_header": {
          "default": false,
          "title": "Is Header",
          "type": "boolean"
        }
      },
      "required": [
        "row",
        "column"
      ],
      "title": "GridPosition",
      "type": "object"
    },
    "Page": {
      "properties": {
        "page_number": {
          "title": "Page Number",
          "type": "integer"
        },
        "status": {
          "$ref": "#/$defs/PageStatus"
        },
        "width": {
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "title": "Height",
          "type": "integer"
        },
        "coordinate_system": {
          "$ref": "#/$defs/CoordinateSystem"
        },
        "source_type": {
          "default": "born_digital",
          "title": "Source Type",
          "type": "string"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/PageIssue"
          },
          "title": "Errors",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/PageIssue"
          },
          "title": "Warnings",
          "type": "array"
        },
        "elements": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Elements",
          "type": "array"
        },
        "diagnostic_elements": {
          "items": {
            "$ref": "#/$defs/Element"
          },
          "title": "Diagnostic Elements",
          "type": "array"
        }
      },
